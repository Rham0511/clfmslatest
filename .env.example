# Local environment configuration
BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=replace-with-a-secure-random-secret-at-least-32-characters

# Database configuration
DB_HOST=localhost
DB_USER=comlab
DB_PASSWORD=replace-with-database-password
DB_NAME=comlab
DB_DIALECT=mysql

# Groq chatbot (keep the API key server-side)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ─── SMTP configuration (Brevo) ─────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=noreply@comlabfacilitiesms.cyou
MAIL_FROM_NAME="Computer Laboratory"

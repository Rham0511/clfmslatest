{
  "id": "/",
  "name": "ComLab Laboratory Facilities Management",
  "short_name": "ComLab",
  "description": "ComLab Laboratory Facilities Management System",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "background_color": "#062719",
  "theme_color": "#062719",
  "orientation": "any",
  "categories": ["education", "productivity"],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.webmanifest",
      "id": "/"
    }
  ],
  "icons": [
    { "src": "/images/comlab-app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/images/comlab-app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}

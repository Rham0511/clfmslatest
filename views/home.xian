<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/sidebar.css?v=11">
  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      min-height: 100%;
      margin: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #f8fafc;
      background: #020806;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    a {
      text-decoration: none;
    }

    .landing-hero {
      position: relative;
      min-height: 100vh;
      background: url('/images/MinSU_Bongabong_enhanced.jpg') center / cover no-repeat;
      filter: saturate(1.4) contrast(1.1) brightness(1.02);
      isolation: isolate;
    }

    .landing-hero::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      content: '';
      background: linear-gradient(135deg, rgba(3, 16, 12, 0.58) 0%, rgba(2, 10, 22, 0.66) 100%);
    }

    .landing-hero-content {
      display: flex;
      min-height: 100vh;
      flex-direction: column;
    }

    .landing-header {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      padding: 0.75rem 2rem;
      border-bottom: 1px solid rgba(52, 211, 153, 0.18);
      background: rgba(3, 12, 9, 0.8);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(20px) saturate(1.3);
      -webkit-backdrop-filter: blur(20px) saturate(1.3);
    }

    .landing-brand-group {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 0.8rem;
    }

    .landing-brand-logo {
      width: 46px;
      height: 46px;
      min-width: 46px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(52, 211, 153, 0.35);
      box-shadow: 0 0 14px rgba(16, 185, 129, 0.28);
    }

    .landing-brand-copy {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: 0.1rem;
    }

    .landing-brand-main {
      color: #f8fafc;
      font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      line-height: 1.2;
      white-space: nowrap;
    }

    .landing-brand-sub {
      color: #34d399;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      white-space: nowrap;
      line-height: 1.2;
    }

    .landing-nav {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }

    .landing-nav a {
      display: inline-flex;
      min-height: 2.3rem;
      align-items: center;
      padding: 0.45rem 0.85rem;
      border: 1px solid transparent;
      border-radius: 0.7rem;
      color: #cbd5e1;
      font-size: 0.88rem;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .landing-nav a:hover,
    .landing-nav a:focus-visible {
      transform: translateY(-1px);
      border-color: rgba(52, 211, 153, 0.3);
      outline: none;
      background: rgba(16, 185, 129, 0.1);
      color: #34d399;
    }

    .landing-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .landing-btn {
      display: inline-flex;
      min-width: 96px;
      align-items: center;
      justify-content: center;
      padding: 0.55rem 1.25rem;
      border-radius: 0.75rem;
      font-size: 0.9rem;
      font-weight: 700;
      font-family: 'Plus Jakarta Sans', sans-serif;
      transition: all 0.2s ease;
    }

    .landing-btn:hover,
    .landing-cta:hover {
      transform: translateY(-2px);
    }

    .landing-btn.secondary {
      border: 1px solid rgba(52, 211, 153, 0.28);
      background: rgba(4, 20, 14, 0.65);
      color: #f8fafc;
    }

    .landing-btn.secondary:hover {
      border-color: #34d399;
      background: rgba(16, 185, 129, 0.18);
      color: #ffffff;
      box-shadow: 0 4px 16px rgba(16, 185, 129, 0.2);
    }

    .landing-btn.primary {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      border: 1px solid rgba(110, 231, 183, 0.3);
      box-shadow: 0 8px 22px rgba(16, 185, 129, 0.35);
    }

    .landing-btn.primary:hover {
      background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
      box-shadow: 0 12px 28px rgba(16, 185, 129, 0.48);
    }

    .landing-btn.secondary:focus-visible,
    .landing-btn.primary:focus-visible,
    .landing-cta:focus-visible {
      outline: 2px solid #93c5fd;
      outline-offset: 3px;
    }

    .mobile-menu-toggle {
      display: none;
      width: 2.5rem;
      height: 2.5rem;
      border: 1px solid rgba(148, 163, 184, .3);
      border-radius: .75rem;
      background: transparent;
      color: #fff;
      font-size: 1.2rem;
      cursor: pointer;
    }

    .mobile-menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 19;
      padding-top: 5.5rem;
      background: rgba(2, 8, 5, .96);
      backdrop-filter: blur(12px);
    }

    .mobile-menu.active {
      display: block;
    }

    .mobile-menu-items {
      display: flex;
      flex-direction: column;
      gap: .4rem;
      padding: 1rem 1.25rem;
    }

    .mobile-menu-items a {
      padding: .8rem 1rem;
      border-radius: .8rem;
      border: 1px solid rgba(148, 163, 184, .12);
      background: rgba(15, 23, 42, .65);
      color: #fff;
      font-weight: 600;
    }

    .landing-main {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      padding: clamp(1rem, 2.8vh, 2.2rem) 1.5rem;
    }

    .landing-hero-grid {
      display: grid;
      width: min(1200px, calc(100% - 2rem));
      grid-template-columns: 1.18fr .82fr;
      align-items: center;
      gap: 2.5rem;
    }

    .landing-copy {
      display: flex;
      max-width: 600px;
      flex-direction: column;
    }

    .session-expired-notice {
      margin: 0 0 1.25rem;
      padding: .9rem 1rem;
      border: 1px solid rgba(252, 211, 77, .48);
      border-radius: .9rem;
      background: rgba(120, 53, 15, .55);
      color: #fef3c7;
      font-size: .92rem;
      font-weight: 700;
      line-height: 1.5;
      gap: 0.85rem;
    }

    .landing-eyebrow {
      display: none;
    }

    .landing-headline {
      margin: 0;
      font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
      color: #ffffff;
      font-size: clamp(2.1rem, 3.6vw, 3.4rem);
      font-weight: 850;
      letter-spacing: -0.035em;
      line-height: 1.08;
      text-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
    }

    .landing-headline-highlight {
      display: block;
      background: linear-gradient(135deg, #4ade80 0%, #10b981 55%, #059669 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 4px 18px rgba(16, 185, 129, 0.35));
    }

    .landing-description {
      max-width: 36rem;
      margin: 0;
      color: rgba(226, 232, 240, 0.95);
      font-size: 1.05rem;
      font-weight: 450;
      line-height: 1.6;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
    }

    .landing-cta-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: .4rem;
    }

    .landing-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      padding: 0.78rem 1.65rem;
      border: 1px solid rgba(110, 231, 183, 0.35);
      border-radius: 0.85rem;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 750;
      font-size: 0.98rem;
      letter-spacing: -0.01em;
      box-shadow: 0 10px 28px rgba(16, 185, 129, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.25);
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .landing-cta:hover {
      transform: translateY(-2px);
      background: linear-gradient(135deg, #22c55e 0%, #10b981 100%);
      box-shadow: 0 16px 36px rgba(16, 185, 129, 0.52), inset 0 1px 0 rgba(255, 255, 255, 0.35);
      filter: brightness(1.05);
    }

    .landing-cta i {
      font-size: 0.9rem;
      transition: transform 0.2s ease;
    }

    .landing-cta:hover i {
      transform: translateX(4px);
    }

    .landing-visual-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .landing-badge-image {
      display: block;
      width: min(20rem, 55vw);
      max-width: 310px;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 0 40px rgba(16, 185, 129, 0.35)) drop-shadow(0 15px 35px rgba(0, 0, 0, 0.6));
      animation: ccsLogoFloat 6s ease-in-out infinite;
    }

    @keyframes ccsLogoFloat {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    @media (max-width: 900px) {
      .landing-header {
        flex-wrap: wrap;
      }

      .landing-nav,
      .landing-actions {
        display: none;
      }

      .mobile-menu-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .landing-hero-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
        text-align: center;
      }

      .landing-copy {
        max-width: none;
        align-items: center;
      }
    }

    @media (max-width: 640px) {
      .landing-header {
        padding: .8rem .9rem;
      }

      .landing-brand-main {
        font-size: .74rem;
      }

      .landing-brand-sub {
        font-size: .56rem;
        letter-spacing: .06em;
      }

      .landing-brand-logo {
        width: 40px;
        height: 40px;
        min-width: 40px;
      }

      .landing-description {
        font-size: .98rem;
      }

      .landing-cta-row {
        justify-content: center;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .landing-btn,
      .landing-cta {
        transition: none;
      }
    }
  </style>
</head>
<body data-public-pc-station-scanner="true">
  <section class="landing-hero">
    <div class="landing-hero-content">
      <header class="landing-header">
        <a href="/" class="landing-brand-group" aria-label="Mindoro State University home">
          <img src="/images/minsu-logo.png.jpg" alt="Mindoro State University Logo" class="landing-brand-logo" />
          <div class="landing-brand-copy">
            <span class="landing-brand-main">Mindoro State University</span>
            <span class="landing-brand-sub">College of Computer Studies</span>
          </div>
        </a>

        <nav class="landing-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/#features">Features</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>

        <div class="landing-actions">
          <a href="/login" class="landing-btn secondary">Login</a>
          <a href="/register" class="landing-btn primary">Sign Up</a>
        </div>

        <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
          <i class="fas fa-bars"></i>
        </button>
      </header>

      <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-items">
          <a href="/login" onclick="closeMobileMenu()">Login</a>
          <a href="/register" onclick="closeMobileMenu()">Sign Up</a>
        </div>
      </div>

      <main class="landing-main">
        <div class="landing-hero-grid">
          <div class="landing-copy">
            {{#if sessionExpiredNotice}}
              <div class="session-expired-notice" data-pc-session-expired role="alert">{{ sessionExpiredNotice }}</div>
            {{/if}}
            <h1 class="landing-headline">
              Computer Laboratory
              <span class="landing-headline-highlight">Facilities Management System</span>
            </h1>
            <p class="landing-description">Manage laboratory logs, equipment reports, inventory, and borrow requests in one centralized platform.</p>
            <div class="landing-cta-row">
              <a href="/login" class="landing-cta">
                <span>Get Started</span>
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="landing-visual-wrap">
            <img src="/images/ccs-logo.png" alt="CCS Logo" class="landing-badge-image" />
          </div>
        </div>
      </main>
    </div>
  </section>

  <script src="/js/qr-scanner-button.js?v=12" defer></script>
  <script>
    if (document.querySelector('[data-pc-session-expired]')) {
      const pendingStationStorageKeys = ['pending_pc_station', 'pending_pc_station_token', 'pendingPcStationToken'];
      try {
        for (const storage of [window.localStorage, window.sessionStorage]) {
          pendingStationStorageKeys.forEach((key) => storage.removeItem(key));
        }
      } catch (error) {
        console.warn('Unable to clear pending PC station browser state after session expiry.', error);
      }
      window.history.replaceState(null, '', '/');
    }

    const mobileMenuToggle = document.getElementById('mobileMenuToggle');
    const mobileMenu = document.getElementById('mobileMenu');

    if (mobileMenuToggle && mobileMenu) {
      mobileMenuToggle.addEventListener('click', function() {
        mobileMenu.classList.toggle('active');
        mobileMenuToggle.classList.toggle('active');
      });
    }

    function closeMobileMenu() {
      if (mobileMenu) mobileMenu.classList.remove('active');
      if (mobileMenuToggle) mobileMenuToggle.classList.remove('active');
    }

    document.addEventListener('click', function(event) {
      if (!event.target.closest('.landing-header') && !event.target.closest('.mobile-menu')) {
        closeMobileMenu();
      }
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') closeMobileMenu();
    });
  </script>

  {{> footer }}

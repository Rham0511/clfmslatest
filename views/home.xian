<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      min-height: 100%;
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #fff;
      background: #07150f;
    }

    a {
      text-decoration: none;
    }

    .landing-hero {
      position: relative;
      min-height: 100vh;
      background: url('/images/MinSU_Bongabong_enhanced.jpg') center / cover no-repeat;
      filter: saturate(1.45) contrast(1.12) brightness(0.96);
      isolation: isolate;
    }

    .landing-hero::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      content: '';
      background: linear-gradient(135deg, rgba(5, 15, 25, .72), rgba(2, 6, 23, .8));
    }

    .landing-hero-content {
      display: flex;
      min-height: 100vh;
      flex-direction: column;
    }

    .landing-header {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: .7rem 1.75rem;
      border-bottom: 1px solid rgba(148, 163, 184, .14);
      background: rgba(7, 17, 31, .72);
      box-shadow: 0 12px 32px rgba(2, 6, 23, .16);
      backdrop-filter: blur(18px) saturate(1.2);
    }

    .landing-brand-group {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: .7rem;
    }

    .landing-brand-logo {
      width: 48px;
      height: 48px;
      min-width: 48px;
      clip-path: circle(49% at 50% 50%);
      object-fit: contain;
      filter: drop-shadow(0 0 12px rgba(16, 185, 129, .24));
    }

    .landing-brand-copy {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: .08rem;
    }

    .landing-brand-main {
      color: #f8fafc;
      font-size: 1.05rem;
      font-weight: 800;
      line-height: 1.2;
      white-space: nowrap;
    }

    .landing-brand-sub {
      color: #a7f3d0;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .2em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .landing-nav {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }

    .landing-nav a {
      display: inline-flex;
      min-height: 2.4rem;
      align-items: center;
      padding: .5rem .75rem;
      border: 1px solid transparent;
      border-radius: .7rem;
      color: #e2e8f0;
      font-size: .88rem;
      font-weight: 650;
      transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease;
    }

    .landing-nav a:hover,
    .landing-nav a:focus-visible {
      transform: translateY(-1px);
      border-color: rgba(96, 165, 250, .2);
      outline: none;
      background: rgba(59, 130, 246, .12);
      color: #bfdbfe;
    }

    .landing-actions {
      display: flex;
      align-items: center;
      gap: .6rem;
    }

    .landing-btn {
      display: inline-flex;
      min-width: 96px;
      align-items: center;
      justify-content: center;
      padding: .55rem 1.15rem;
      border: 1px solid transparent;
      border-radius: .75rem;
      font-size: .9rem;
      font-weight: 800;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }

    .landing-btn:hover,
    .landing-cta:hover {
      transform: translateY(-1px);
    }

    .landing-btn.secondary {
      border: 1px solid rgba(148, 163, 184, .3);
      background: rgba(15, 23, 42, .55);
      color: #f8fafc;
    }

    .landing-btn.primary {
      background: linear-gradient(135deg, #22c55e, #16a34a);
      color: #fff;
      box-shadow: 0 10px 24px rgba(34, 197, 94, .25);
    }

    .landing-btn.secondary:focus-visible,
    .landing-btn.primary:focus-visible,
    .landing-cta:focus-visible {
      outline: 2px solid #93c5fd;
      outline-offset: 3px;
    }

    .mobile-menu-toggle {
      display: none;
      width: 2.5rem;
      height: 2.5rem;
      border: 1px solid rgba(148, 163, 184, .3);
      border-radius: .75rem;
      background: transparent;
      color: #fff;
      font-size: 1.2rem;
      cursor: pointer;
    }

    .mobile-menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 19;
      padding-top: 5.5rem;
      background: rgba(2, 8, 5, .96);
      backdrop-filter: blur(12px);
    }

    .mobile-menu.active {
      display: block;
    }

    .mobile-menu-items {
      display: flex;
      flex-direction: column;
      gap: .4rem;
      padding: 1rem 1.25rem;
    }

    .mobile-menu-items a {
      padding: .8rem 1rem;
      border-radius: .8rem;
      border: 1px solid rgba(148, 163, 184, .12);
      background: rgba(15, 23, 42, .65);
      color: #fff;
      font-weight: 600;
    }

    .landing-main {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      padding: 5rem 1rem 4rem;
    }

    .landing-hero-grid {
      display: grid;
      width: min(1200px, calc(100% - 2rem));
      grid-template-columns: 1.15fr .85fr;
      align-items: center;
      gap: 3rem;
    }

    .landing-copy {
      display: flex;
      max-width: 620px;
      flex-direction: column;
      gap: 1.1rem;
      text-shadow: 0 2px 20px rgba(2, 6, 23, .52);
    }

    .landing-eyebrow {
      margin: 0;
      color: #a7f3d0;
      font-size: 1.5rem;
      font-weight: 900;
      letter-spacing: .16em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .landing-copy h1 {
      margin: 0;
      color: #f8fafc;
      font-size: clamp(3rem, 5vw, 5rem);
      font-weight: 800;
      letter-spacing: -.06em;
      line-height: 1.02;
      text-shadow: 0 2px 18px rgba(2, 6, 23, .28);
    }

    .landing-description {
      max-width: 40rem;
      margin: 0;
      color: rgba(248, 250, 252, .98);
      font-size: 1.35rem;
      line-height: 1.65;
      text-shadow: 0 2px 18px rgba(2, 6, 23, .28);
    }

    .landing-cta-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: .4rem;
    }

    .landing-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: .8rem 1.35rem;
      border: 1px solid rgba(110, 231, 183, .24);
      border-radius: .85rem;
      background: linear-gradient(135deg, #16a34a, #059669);
      color: #f8fafc;
      font-weight: 800;
      box-shadow: 0 12px 28px rgba(5, 150, 105, .24);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .landing-visual-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .landing-badge-image {
      display: block;
      width: min(22rem, 70vw);
      max-width: 340px;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 10px 24px rgba(2, 6, 23, .28));
      background: transparent;
      padding: 0;
      border-radius: 0;
      box-shadow: none;
    }

    @media (max-width: 900px) {
      .landing-header {
        flex-wrap: wrap;
      }

      .landing-nav,
      .landing-actions {
        display: none;
      }

      .mobile-menu-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .landing-hero-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
        text-align: center;
      }

      .landing-copy {
        max-width: none;
        align-items: center;
      }
    }

    @media (max-width: 640px) {
      .landing-header {
        padding: .8rem .9rem;
      }

      .landing-brand-main {
        font-size: .74rem;
      }

      .landing-brand-sub {
        font-size: .56rem;
        letter-spacing: .06em;
      }

      .landing-brand-logo {
        width: 40px;
        height: 40px;
        min-width: 40px;
      }

      .landing-description {
        font-size: .98rem;
      }

      .landing-cta-row {
        justify-content: center;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .landing-btn,
      .landing-cta {
        transition: none;
      }
    }
  </style>
</head>
<body>
  <section class="landing-hero">
    <div class="landing-hero-content">
      <header class="landing-header">
        <a href="/" class="landing-brand-group" aria-label="Mindoro State University home">
          <img src="/images/minsu-logo.png.jpg" alt="Mindoro State University Logo" class="landing-brand-logo" />
          <div class="landing-brand-copy">
            <span class="landing-brand-main">Mindoro State University</span>
            <span class="landing-brand-sub">College of Computer Studies</span>
          </div>
        </a>

        <nav class="landing-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/#features">Features</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>

        <div class="landing-actions">
          <a href="/login" class="landing-btn secondary">Login</a>
          <a href="/register" class="landing-btn primary">Sign Up</a>
        </div>

        <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
          <i class="fas fa-bars"></i>
        </button>
      </header>

      <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-items">
          <a href="/login" onclick="closeMobileMenu()">Login</a>
          <a href="/register" onclick="closeMobileMenu()">Sign Up</a>
        </div>
      </div>

      <main class="landing-main">
        <div class="landing-hero-grid">
          <div class="landing-copy">
            <p class="landing-eyebrow">Welcome to</p>
            <h1>Computer Laboratory Facilities Management System</h1>
            <p class="landing-description">Efficiently manage laboratory schedules, attendance, equipment inventory, and maintenance requests in one centralized platform.</p>
            <div class="landing-cta-row">
              <a href="/login" class="landing-cta">Get Started</a>
            </div>
          </div>

          <div class="landing-visual-wrap">
            <img src="/images/ccs-logo.png" alt="CCS Logo" class="landing-badge-image" />
          </div>
        </div>
      </main>
    </div>
  </section>

  <script>
    const mobileMenuToggle = document.getElementById('mobileMenuToggle');
    const mobileMenu = document.getElementById('mobileMenu');

    if (mobileMenuToggle && mobileMenu) {
      mobileMenuToggle.addEventListener('click', function() {
        mobileMenu.classList.toggle('active');
        mobileMenuToggle.classList.toggle('active');
      });
    }

    function closeMobileMenu() {
      if (mobileMenu) mobileMenu.classList.remove('active');
      if (mobileMenuToggle) mobileMenuToggle.classList.remove('active');
    }

    document.addEventListener('click', function(event) {
      if (!event.target.closest('.landing-header') && !event.target.closest('.mobile-menu')) {
        closeMobileMenu();
      }
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') closeMobileMenu();
    });
  </script>
</body>
</html>

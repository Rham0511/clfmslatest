{{> head}}
<body class="min-h-screen bg-[#070f0a]" style="background:radial-gradient(ellipse at 50% 0%,rgba(20,83,45,0.38) 0%,transparent 65%),#070f0a;">

  <!-- Subtle animated background blobs -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden">
    <div class="absolute -top-40 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-emerald-900/20 blur-[120px]"></div>
    <div class="absolute bottom-0 right-0 h-72 w-72 rounded-full bg-cyan-900/10 blur-[90px]"></div>
  </div>

  <div class="relative flex min-h-[100dvh] items-center justify-center px-4 py-8 sm:py-12">
    <div class="w-full max-w-md">

      <!-- Card -->
      <div class="rounded-[28px] border border-emerald-400/20 bg-[rgba(10,24,18,0.92)] p-5 shadow-[0_24px_70px_rgba(0,0,0,0.5)] backdrop-blur-[18px] sm:p-8">

        <!-- Icon -->
        <div class="mb-6 flex justify-center">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl border border-emerald-500/25 bg-emerald-500/15 shadow-[0_0_30px_rgba(34,197,94,0.15)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
        </div>

        <!-- Title -->
        <div class="mb-2 text-center">
          <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.24em] text-emerald-400">
            {{#if isPasswordReset}}Password reset{{else}}Email verification{{/if}}
          </p>
          <h1 class="text-2xl font-bold tracking-tight text-white">
            {{#if isPasswordReset}}Enter your reset code{{else}}Verify your email{{/if}}
          </h1>
          <p class="mt-2 text-sm text-slate-400">
            {{#if isPasswordReset}}We sent a reset code to{{else}}We sent a 6-digit code to{{/if}}
            <span class="font-semibold text-emerald-300">{{maskedEmail}}</span>
          </p>
        </div>

        <!-- Flash messages -->
        {{#if error_msg}}
          <div class="mt-4 rounded-xl border border-red-400/25 bg-red-500/10 px-4 py-3 text-sm text-red-300">{{error_msg}}</div>
        {{/if}}
        {{#if success_msg}}
          <div class="mt-4 rounded-xl border border-emerald-400/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">{{success_msg}}</div>
        {{/if}}

        <!-- OTP Form -->
        <form id="otpForm" method="POST" action="/verify-otp" class="mt-7">

          <!-- 6 individual digit boxes -->
          <div class="flex justify-center gap-2 sm:gap-3" role="group" aria-label="Enter the 6-digit verification code">
            <input id="d1" name="d1" type="text" inputmode="numeric" maxlength="6"
              class="otp-box h-12 w-10 rounded-xl border border-white/10 bg-white/[0.06] text-center text-xl font-bold text-white shadow-[0_4px_16px_rgba(0,0,0,0.3)] outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 sm:h-14 sm:w-11 sm:rounded-[14px]"
              aria-label="6-digit verification code" autocomplete="one-time-code" />
            <input id="d2" name="d2" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
              class="otp-box h-12 w-10 rounded-xl border border-white/10 bg-white/[0.06] text-center text-xl font-bold text-white shadow-[0_4px_16px_rgba(0,0,0,0.3)] outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 sm:h-14 sm:w-11 sm:rounded-[14px]"
              aria-label="Digit 2" />
            <input id="d3" name="d3" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
              class="otp-box h-12 w-10 rounded-xl border border-white/10 bg-white/[0.06] text-center text-xl font-bold text-white shadow-[0_4px_16px_rgba(0,0,0,0.3)] outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 sm:h-14 sm:w-11 sm:rounded-[14px]"
              aria-label="Digit 3" />
            <input id="d4" name="d4" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
              class="otp-box h-12 w-10 rounded-xl border border-white/10 bg-white/[0.06] text-center text-xl font-bold text-white shadow-[0_4px_16px_rgba(0,0,0,0.3)] outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 sm:h-14 sm:w-11 sm:rounded-[14px]"
              aria-label="Digit 4" />
            <input id="d5" name="d5" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
              class="otp-box h-12 w-10 rounded-xl border border-white/10 bg-white/[0.06] text-center text-xl font-bold text-white shadow-[0_4px_16px_rgba(0,0,0,0.3)] outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 sm:h-14 sm:w-11 sm:rounded-[14px]"
              aria-label="Digit 5" />
            <input id="d6" name="d6" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]"
              class="otp-box h-12 w-10 rounded-xl border border-white/10 bg-white/[0.06] text-center text-xl font-bold text-white shadow-[0_4px_16px_rgba(0,0,0,0.3)] outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/30 sm:h-14 sm:w-11 sm:rounded-[14px]"
              aria-label="Digit 6" />
          </div>


          <!-- Countdown timer -->
          <p id="timerText" class="mt-5 text-center text-xs text-slate-400">Code expires in <span id="countdown" class="font-semibold text-slate-200">10:00</span></p>

          <!-- Submit -->
          <button id="submitBtn" type="submit"
            class="mt-6 flex w-full items-center justify-center gap-2 rounded-[16px] bg-gradient-to-r from-emerald-500 to-cyan-500 px-6 py-3.5 text-sm font-semibold text-slate-950 shadow-[0_12px_28px_rgba(34,197,94,0.25)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_32px_rgba(34,197,94,0.35)] disabled:cursor-not-allowed disabled:opacity-60">
            Verify &amp; Complete
          </button>
        </form>

        <!-- Resend -->
        <p class="mt-5 text-center text-sm text-slate-500">
          Didn't receive the code?
          <a href="/resend-otp" class="font-semibold text-emerald-400 hover:text-emerald-300 transition-colors">Resend</a>
        </p>

      </div><!-- /card -->
    </div>
  </div>

  <script>
    // ── Auto-advance OTP boxes ────────────────────────────────────────────────
    const boxes = Array.from(document.querySelectorAll('.otp-box'));
    const otpForm = document.getElementById('otpForm');

    function fillOtp(rawCode, submitWhenComplete = false) {
      const digits = String(rawCode || '').replace(/\D/g, '').slice(0, 6);
      boxes.forEach((box, index) => { box.value = digits[index] || ''; });
      if (digits.length === 6) {
        boxes[5].focus();
        if (submitWhenComplete) otpForm.requestSubmit();
      } else {
        boxes[digits.length]?.focus();
      }
      return digits.length;
    }

    boxes.forEach((box, i) => {
      box.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !box.value && i > 0) {
          boxes[i - 1].focus();
        }
      });

      box.addEventListener('input', () => {
        const entered = box.value.replace(/\D/g, '');
        // Browsers may autofill the full code into the first segmented field.
        if (i === 0 && entered.length > 1) {
          fillOtp(entered, true);
          return;
        }
        box.value = entered.slice(-1);
        if (box.value && i < boxes.length - 1) {
          boxes[i + 1].focus();
        }
        // Auto-submit when all filled
        if (boxes.every(b => b.value)) {
          otpForm.requestSubmit();
        }
      });

      // Handle paste on any box
      box.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasted = (e.clipboardData || window.clipboardData).getData('text');
        fillOtp(pasted, true);
      });
    });

    otpForm.addEventListener('submit', () => {
      const submitButton = document.getElementById('submitBtn');
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      submitButton.textContent = 'Verifying code…';
    });

    // Focus first box on load
    boxes[0]?.focus();

    // ── Countdown timer (10 min) ──────────────────────────────────────────────
    let seconds = 10 * 60;
    const countdownEl = document.getElementById('countdown');
    const timerText   = document.getElementById('timerText');

    const tick = setInterval(() => {
      seconds--;
      if (seconds <= 0) {
        clearInterval(tick);
        countdownEl.textContent = '0:00';
        timerText.textContent = 'Code expired. Please request a new one.';
        timerText.classList.add('text-red-400');
        timerText.classList.remove('text-slate-500');
        document.getElementById('submitBtn').disabled = true;
        return;
      }
      const m = Math.floor(seconds / 60);
      const s = String(seconds % 60).padStart(2, '0');
      countdownEl.textContent = `${m}:${s}`;
    }, 1000);
  </script>

{{> footer}}

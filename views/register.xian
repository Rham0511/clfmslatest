{{> head}}
<body class="register-page relative overflow-x-hidden text-slate-100">
  <style>
    .register-page {
      min-height: 100vh;
      min-height: 100dvh;
      margin: 0;
      background:
        linear-gradient(135deg, rgba(8, 18, 28, .78), rgba(2, 8, 20, .76)),
        url('/images/MinSU_Bongabong_enhanced.jpg') center / cover fixed no-repeat;
      filter: saturate(1.5) contrast(1.08) brightness(0.98);
    }

    .register-bg {
      position: relative;
      isolation: isolate;
      background: url('/images/MinSU_Bongabong_enhanced.jpg') center / cover no-repeat;
      filter: saturate(1.5) contrast(1.08) brightness(0.98);
    }

    .register-bg::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      content: '';
      background: linear-gradient(135deg, rgba(3, 16, 12, 0.58) 0%, rgba(2, 10, 22, 0.66) 100%);
    }

    .register-card {
      max-height: calc(100vh - 100px);
    }

    .register-card-content {
      max-height: calc(100vh - 180px);
    }

    .custom-scrollbar::-webkit-scrollbar {
      width: 8px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(2, 40, 20, 0.45);
      border-radius: 9999px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(52, 211, 153, 0.6);
      border-radius: 9999px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(52, 211, 153, 0.8);
    }

    @media (min-width: 1024px) {
      .register-bg {
        height: 100vh;
        min-height: 100vh;
        padding: 0 1rem;
      }

      .register-card {
        max-height: calc(100vh - 160px);
        padding: 1.5rem;
        box-shadow: none;
      }

      .register-card-content {
        max-height: none;
        overflow: visible;
        padding-right: 0;
      }

      .register-card-content > .register-logo {
        margin-bottom: 0.5rem;
      }

      .register-card-content > .register-logo img {
        width: 2.5rem;
        height: 2.5rem;
      }

      .register-card-content > .register-heading {
        margin-bottom: 0.75rem;
      }

      .register-card-content > .register-heading p {
        margin-top: 0.35rem;
      }

      .register-card-content > .register-heading .register-qr-notice {
        margin-top: 0.5rem;
        padding: 0.5rem 0.75rem;
        font-size: 0.75rem;
      }

      .register-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.4rem 1rem;
        padding-bottom: 0;
      }

      .register-form-grid > :not([hidden]) ~ :not([hidden]) {
        margin-top: 0;
      }

      .register-form-grid > .register-form-row,
      .register-form-grid > .register-student-fields:not([hidden]),
      .register-student-fields:not([hidden]) > .register-form-row {
        display: contents;
      }

      .register-form-grid > .register-full-field,
      .register-form-grid > .register-submit {
        grid-column: 1 / -1;
      }

      .register-form-grid > label,
      .register-student-fields label {
        align-self: end;
        font-size: 0.8125rem;
        line-height: 1.125rem;
      }

      .register-student-fields > h2 {
        grid-column: 1 / -1;
        margin: 0;
        font-size: 0.75rem;
        line-height: 1rem;
      }

      .register-form-grid label input,
      .register-form-grid label select {
        min-height: 2.25rem;
        margin-top: 0.2rem;
        padding: 0.3rem 0.7rem;
      }

      .register-form-grid .register-submit {
        margin-top: 0;
      }

      .register-card-content .register-footer {
        display: flex;
        justify-content: center;
        gap: 0.25rem 1rem;
        margin-top: 0.75rem;
        padding-bottom: 0;
        font-size: 0.75rem;
      }

      .register-card-content .register-footer > :not([hidden]) ~ :not([hidden]) {
        margin-top: 0;
      }
    }

    @media (min-width: 1024px) and (max-height: 699px) {
      .register-bg {
        padding-top: 5rem;
        padding-bottom: 0.5rem;
      }

      .register-card {
        max-height: calc(100vh - 140px);
        padding: 1rem;
      }

      .register-card-content > .register-logo {
        margin-bottom: 0.15rem;
      }

      .register-card-content > .register-logo img {
        width: 1.75rem;
        height: 1.75rem;
      }

      .register-card-content > .register-heading {
        margin-bottom: 0.35rem;
      }

      .register-card-content > .register-heading h1 {
        font-size: 1.125rem;
        line-height: 1.5rem;
      }

      .register-card-content > .register-heading > p:not(.register-qr-notice) {
        display: none;
      }

      .register-card-content > .register-heading .register-qr-notice {
        margin-top: 0.25rem;
        padding: 0.35rem 0.5rem;
        font-size: 0.6875rem;
        line-height: 1rem;
      }

      .register-form-grid {
        gap: 0.2rem 0.75rem;
      }

      .register-form-grid > label,
      .register-student-fields label {
        font-size: 0.6875rem;
        line-height: 0.875rem;
      }

      .register-form-grid label input,
      .register-form-grid label select {
        min-height: 1.85rem;
        margin-top: 0.1rem;
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
      }

      .register-student-fields > h2 {
        font-size: 0.6875rem;
        line-height: 1rem;
      }

      .register-form-grid .register-submit button {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        font-size: 0.875rem;
      }

      .register-card-content .register-footer {
        display: flex;
        justify-content: center;
        gap: 0.25rem 0.75rem;
        margin-top: 0.5rem;
        font-size: 0.75rem;
      }

      .register-card-content .register-footer > :not([hidden]) ~ :not([hidden]) {
        margin-top: 0;
      }
    }

    .register-bg {
      min-height: 100vh;
      min-height: 100dvh;
      padding: 5rem 2rem 1rem;
    }

    .register-layout {
      display: grid;
      width: min(1200px, 100%);
      grid-template-columns: minmax(0, 1fr) minmax(0, 540px);
      align-items: center;
      gap: clamp(2rem, 7vw, 7rem);
      margin: 0 auto;
    }

    .register-intro {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .register-intro-eyebrow {
      display: none;
    }

    .register-headline {
      margin: 0;
      font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
      color: #ffffff;
      font-size: clamp(2.4rem, 4.2vw, 3.8rem);
      font-weight: 850;
      letter-spacing: -0.035em;
      line-height: 1.08;
      text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    }

    .register-headline-highlight {
      display: block;
      background: linear-gradient(135deg, #4ade80 0%, #10b981 55%, #059669 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 4px 18px rgba(16, 185, 129, 0.35));
    }

    .register-intro p:last-child {
      max-width: 36rem;
      margin: 0;
      color: rgba(226, 232, 240, .92);
      font-size: 1.12rem;
      line-height: 1.65;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
    }

    .register-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }

    .register-nav a {
      display: inline-flex;
      min-height: 2.5rem;
      align-items: center;
      justify-content: center;
      padding: .5rem .75rem;
      border: 1px solid transparent;
      border-radius: .75rem;
      color: #e2e8f0;
      font-size: .88rem;
      font-weight: 650;
      transition: color .2s ease, background .2s ease, border-color .2s ease, transform .2s ease;
    }

    .register-nav a:hover,
    .register-nav a:focus-visible {
      transform: translateY(-1px);
      border-color: rgba(96, 165, 250, .2);
      outline: none;
      background: rgba(59, 130, 246, .12);
      color: #bfdbfe;
    }

    .register-header {
      padding: .7rem 1.75rem;
      border-bottom-color: rgba(148, 163, 184, .14);
      background: rgba(7, 17, 31, .72);
      box-shadow: 0 12px 32px rgba(2, 6, 23, .16);
      backdrop-filter: blur(18px) saturate(1.2);
    }

    .register-header .register-brand {
      gap: .7rem;
    }

    .register-university-logo {
      width: 48px;
      height: 48px;
      min-width: 48px;
      clip-path: circle(49% at 50% 50%);
      object-fit: contain;
      filter: drop-shadow(0 0 12px rgba(16, 185, 129, .24));
    }

    .register-brand-name {
      font-size: 1.05rem;
    }

    .register-header .register-nav a:focus-visible {
      outline: 2px solid #93c5fd;
      outline-offset: 3px;
    }

    .register-card-wrap {
      width: 100%;
    }

    .register-card {
      width: 100%;
      max-height: calc(100vh - 100px);
      border: 1px solid rgba(52, 211, 153, 0.35) !important;
      border-radius: 1.5rem !important;
      background: linear-gradient(165deg,
        rgba(5, 32, 22, 0.85) 0%,
        rgba(3, 20, 15, 0.9) 50%,
        rgba(2, 11, 8, 0.95) 100%
      ) !important;
      box-shadow:
        0 0 35px rgba(16, 185, 129, 0.18),
        0 25px 60px rgba(0, 0, 0, 0.65),
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        inset 0 0 20px rgba(16, 185, 129, 0.06) !important;
      backdrop-filter: blur(28px) saturate(1.35) !important;
      -webkit-backdrop-filter: blur(28px) saturate(1.35) !important;
    }

    .register-card .register-form-grid input,
    .register-card .register-form-grid select {
      border: 1px solid rgba(52, 211, 153, 0.3) !important;
      background-color: rgba(2, 22, 15, 0.72) !important;
      border-radius: 0.75rem !important;
      color: #ffffff !important;
    }

    .register-card .register-form-grid input:focus,
    .register-card .register-form-grid select:focus {
      border-color: #34d399 !important;
      background-color: rgba(2, 30, 20, 0.9) !important;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.22) !important;
      outline: none !important;
    }

    .register-card .register-form-grid input::placeholder {
      color: rgba(110, 231, 183, .72);
      letter-spacing: .01em;
    }

    .register-card .register-form-grid label {
      color: #d1fae5;
      font-weight: 700;
      letter-spacing: .01em;
    }

    .register-card .register-form-grid select {
      color: #f0fdf4 !important;
      font-weight: 600 !important;
      letter-spacing: .005em;
    }

    .register-card .register-form-grid select:invalid {
      color: rgba(167, 243, 208, .78) !important;
    }

    .register-form-grid {
      display: block;
    }

    .register-step {
      display: grid;
      gap: .85rem;
    }

    .register-step[hidden] {
      display: none !important;
    }

    .register-college-field[hidden] {
      display: none !important;
    }

    .register-student-fields[hidden] {
      display: none !important;
    }

    .register-step .register-student-fields {
      display: grid;
      gap: .85rem;
    }

    .register-step .register-student-fields > :not([hidden]) ~ :not([hidden]) {
      margin-top: 0;
    }

    .register-step-indicator {
      margin: 0 0 1rem;
      color: #a7f3d0;
      font-size: .8rem;
      font-weight: 700;
      text-align: center;
    }

    .register-step-controls {
      display: flex;
      gap: .75rem;
      margin-top: 1rem;
    }

    .register-step-controls button {
      flex: 1;
      min-height: 2.75rem;
      border: 1px solid rgba(74, 222, 128, .35);
      border-radius: .75rem;
      background: rgba(2, 40, 20, .45);
      color: #ecfdf5;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }

    .register-step-controls button:hover {
      background: rgba(34, 197, 94, .15);
    }

    .register-step-controls .register-next,
    .register-step-controls .register-create {
      border-color: transparent;
      background: #10b981;
      color: #020617;
    }

    .register-step-controls .register-next:hover,
    .register-step-controls .register-create:hover {
      background: #34d399;
    }

    .register-password-control {
      position: relative;
      margin-top: .35rem;
    }

    .register-password-control input {
      width: 100%;
      min-height: 2.75rem;
      margin-top: 0;
      padding-right: 3rem;
    }

    .register-password-toggle {
      position: absolute;
      top: 50%;
      right: .55rem;
      display: grid;
      width: 2.1rem;
      height: 2.1rem;
      padding: .45rem;
      transform: translateY(-50%);
      place-items: center;
      border: 0;
      border-radius: .55rem;
      background: transparent;
      color: #a7f3d0;
      cursor: pointer;
    }

    .register-password-toggle:hover,
    .register-password-toggle:focus-visible {
      outline: none;
      background: rgba(34, 197, 94, .14);
      color: #d1fae5;
    }

    .register-password-toggle svg {
      width: 1.2rem;
      height: 1.2rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
    }

    @media (max-width: 1023px) {
      .register-header {
        position: relative;
        padding: .8rem 1.25rem;
      }

      .register-header > div {
        flex-wrap: wrap;
      }

      .register-nav {
        flex: 1 0 100%;
      }

      .register-bg {
        align-items: flex-start;
        height: auto;
        padding: 3.5rem 1.5rem 2rem;
      }

      .register-layout {
        width: 100%;
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .register-step[data-register-step="3"] {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .register-step[data-register-step="3"] > .register-step-indicator,
      .register-step[data-register-step="3"] > .register-step-controls,
      .register-step[data-register-step="3"] > .register-student-fields {
        grid-column: 1 / -1;
      }

      .register-step[data-register-step="3"] > .register-student-fields {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .register-step[data-register-step="3"] > .register-student-fields > .register-form-row {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .register-intro {
        display: none;
        align-items: center;
        gap: .75rem;
        text-align: center;
      }

      .register-intro h1 {
        font-size: clamp(2rem, 7vw, 3rem);
      }

      .register-intro p:last-child {
        font-size: .98rem;
      }

      .register-card {
        max-height: none;
      }

      .register-card-content {
        max-height: none;
      }
    }

    @media (max-width: 640px) {
      .register-header {
        padding: .7rem .85rem;
      }

      .register-brand {
        min-width: 0;
      }

      .register-brand img {
        width: 42px;
        height: 42px;
        min-width: 42px;
      }

      .register-brand-copy {
        min-width: 0;
      }

      .register-brand-name {
        font-size: .82rem;
        white-space: normal;
      }

      .register-brand-subtitle {
        font-size: .5rem;
        letter-spacing: .1em;
        white-space: normal;
      }

      .register-nav {
        flex-wrap: wrap;
        gap: .15rem;
        padding-top: .15rem;
        border-top: 1px solid rgba(255, 255, 255, .08);
      }

      .register-nav a {
        min-height: 2.2rem;
        padding: .45rem .6rem;
        font-size: .78rem;
      }

      .register-bg {
        padding: 1rem .85rem 1.5rem;
      }

      .register-intro {
        display: none;
      }

      .register-layout {
        gap: 1rem;
      }

      .register-intro {
        gap: .4rem;
      }

      .register-intro-eyebrow {
        font-size: .78rem;
        letter-spacing: .17em;
      }

      .register-intro h1 {
        font-size: clamp(1.65rem, 7vw, 2.25rem);
      }

      .register-intro p:last-child {
        font-size: .86rem;
        line-height: 1.45;
      }

      .register-card {
        padding: 1.1rem;
        border-width: 1px;
        border-radius: 1.2rem;
      }

      .register-card-content {
        padding-right: 0;
      }

      .register-card-content > .register-logo {
        margin-bottom: .75rem;
      }

      .register-card-content > .register-logo img {
        width: 3rem;
        height: 3rem;
      }

      .register-card-content > .register-heading {
        margin-bottom: 1.15rem;
      }

      .register-card-content > .register-heading h1 {
        font-size: 1.35rem;
        line-height: 1.5rem;
      }

      .register-card-content > .register-heading > p:not(.register-qr-notice) {
        margin-top: .35rem;
        font-size: .82rem;
        line-height: 1.4;
      }

      .register-form-grid {
        padding-bottom: .25rem;
      }

      .register-form-row {
        grid-template-columns: minmax(0, 1fr);
        gap: .75rem;
      }

      .register-form-grid label,
      .register-student-fields label {
        font-size: .84rem;
      }

      .register-form-grid label input,
      .register-form-grid label select {
        min-height: 2.75rem;
        margin-top: .35rem;
        padding: .65rem .8rem;
        font-size: 1rem;
      }

      .register-form-grid .register-password-control input {
        margin-top: 0;
      }

      .register-step-controls {
        gap: .6rem;
        margin-top: .25rem;
      }

      .register-step-controls button {
        min-height: 2.8rem;
        padding: .55rem .7rem;
      }

      .register-card-content .register-footer {
        display: grid;
        gap: .65rem;
        margin-top: .75rem;
        padding-bottom: .25rem;
        font-size: .8rem;
      }

      .register-card-content .register-footer {
        display: none;
      }
    }

    @media (max-width: 380px) {
      .register-bg {
        padding-right: .65rem;
        padding-left: .65rem;
      }

      .register-card {
        padding: .9rem;
      }

      .register-step-controls {
        gap: .45rem;
      }

      .register-step-controls button {
        font-size: .9rem;
      }
    }

    @media (max-width: 640px) {
      .register-card-content .register-footer.register-footer {
        display: flex;
        gap: .3rem;
        margin-top: .4rem;
        padding: .45rem .1rem 0;
        font-size: .65rem;
      }

      .register-card-content .register-footer-home a {
        min-height: 0;
        padding: 0;
        font-size: .65rem;
      }
    }

    .register-card-content .register-footer.register-footer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .65rem;
      margin-top: 1rem;
      padding: .9rem .25rem .2rem;
      border-top: 1px solid rgba(167, 243, 208, .12);
      color: rgba(226, 232, 240, .78);
      font-size: .82rem;
      text-align: center;
    }

    .register-card-content .register-footer > p {
      margin: 0;
      line-height: 1.5;
    }

    .register-footer-account a {
      margin-left: .2rem;
      color: #6ee7b7;
      font-weight: 800;
      text-decoration: none;
      text-underline-offset: .2em;
    }

    .register-footer-account a:hover,
    .register-footer-account a:focus-visible {
      color: #a7f3d0;
      text-decoration: underline;
    }

    .register-footer-home a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 0;
      color: #6ee7b7;
      font-size: .78rem;
      font-weight: 700;
      text-decoration: none;
      transition: color .2s ease;
    }

    .register-footer-home {
      align-self: flex-start;
    }

    .register-footer-home a:hover,
    .register-footer-home a:focus-visible {
      color: #a7f3d0;
      outline: none;
      text-decoration: underline;
      text-underline-offset: .2em;
    }

    @media (min-width: 1024px) {
      .register-bg {
        height: auto;
        min-height: 100vh;
        min-height: 100dvh;
        padding: 5rem 2rem 1rem;
      }

      .register-layout {
        width: min(1280px, 100%);
        grid-template-columns: minmax(0, 1fr) minmax(500px, 560px);
        gap: clamp(2rem, 5vw, 5rem);
      }

      .register-intro h1 {
        max-width: 14ch;
        font-size: clamp(2.5rem, 4vw, 3.5rem);
        line-height: 1.08;
      }

      .register-card.custom-scrollbar {
        max-height: none;
        overflow: visible !important;
        padding: 1.5rem;
      }

      .register-card-content {
        max-height: none;
        overflow: visible;
      }

      .register-form-grid {
        display: block;
        padding-bottom: 0;
      }

      .register-step {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-content: start;
        gap: .75rem 1rem;
      }

      .register-step > .register-step-indicator,
      .register-step > .register-step-controls,
      .register-step > .register-form-row,
      .register-step > .register-full-field,
      .register-step > .register-student-fields {
        grid-column: 1 / -1;
      }

      .register-step > .register-form-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem 1rem;
      }

      .register-step > .register-student-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .65rem 1rem;
      }

      .register-form-grid .register-step > .register-student-fields > .register-form-row {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem 1rem;
      }

      .register-step > .register-student-fields h2 {
        grid-column: 1 / -1;
        margin: 0;
      }

      .register-step .register-form-row > label,
      .register-step > label {
        min-width: 0;
      }

      .register-step label input,
      .register-step label select {
        width: 100%;
        min-width: 0;
      }

      .register-step .register-full-field {
        grid-column: 1 / -1;
      }

      .register-step-indicator {
        margin-bottom: .15rem;
      }

      .register-step-controls {
        margin-top: .25rem;
      }
    }

    @media (max-width: 1023px) {
      .register-card.custom-scrollbar {
        max-height: none;
        overflow: visible !important;
      }

      .register-card-content {
        max-height: none;
        overflow: visible;
      }
    }

    @media (max-width: 640px) {
      .register-step {
        gap: .75rem;
      }

      .register-step > .register-form-row,
      .register-step > .register-student-fields,
      .register-step > .register-student-fields > .register-form-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: .75rem;
      }

      .register-step > .register-student-fields {
        grid-column: 1 / -1;
      }
    }

    @media (min-width: 1024px) {
      .register-bg {
        min-height: 100vh;
        min-height: 100dvh;
        height: 100vh;
        padding: 6rem 2rem 2rem;
      }

      .register-card.custom-scrollbar {
        max-height: none;
        overflow: visible !important;
      }

      .register-layout {
        align-items: center;
      }

      .register-card {
        padding: 1rem 1.5rem;
        transform: scale(.92);
        transform-origin: center;
      }

      .register-card-content > .register-logo {
        margin-bottom: .35rem;
      }

      .register-card-content > .register-logo img {
        width: 2.75rem;
        height: 2.75rem;
      }

      .register-card-content > .register-heading {
        margin-bottom: .75rem;
      }

      .register-card-content > .register-heading h1 {
        font-size: 1.25rem;
        line-height: 1.4;
      }

      .register-card-content > .register-heading p {
        margin-top: .2rem;
        font-size: .72rem;
      }

      .register-stepper {
        margin-bottom: .8rem;
      }

      .register-step {
        gap: .55rem 1rem;
      }

      .register-step-indicator {
        margin-bottom: 0;
        font-size: .72rem;
      }

      .register-step label {
        font-size: .76rem;
      }

      .register-step label input,
      .register-step label select {
        min-height: 2.15rem;
        margin-top: .15rem;
        padding: .35rem .7rem;
        font-size: .78rem;
      }

      .register-password-control {
        margin-top: .15rem;
      }

      .register-password-control input {
        min-height: 2.15rem;
      }

      .register-step-hint {
        margin-top: .25rem;
        font-size: .68rem;
        line-height: 1.35;
      }

      .register-step-controls {
        margin-top: .15rem;
      }

      .register-card-content .register-footer.register-footer {
        margin-top: .6rem;
        padding-top: .55rem;
        font-size: .7rem;
      }
    }

    .register-stepper {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: .5rem;
      margin: 0 0 1.4rem;
      padding: 0;
    }

    .register-stepper-item {
      position: relative;
      display: flex;
      min-width: 0;
      flex: 1 1 0;
      flex-direction: column;
      align-items: center;
      gap: .45rem;
      color: rgba(167, 243, 208, .5);
      font-size: .68rem;
      font-weight: 800;
      letter-spacing: .09em;
      text-align: center;
      text-transform: uppercase;
    }

    .register-stepper-item::before {
      position: absolute;
      top: 1.05rem;
      right: calc(50% + 1.15rem);
      left: calc(-50% + 1.15rem);
      height: 2px;
      content: '';
      background: rgba(52, 211, 153, .2);
      transition: background .25s ease;
    }

    .register-stepper-item:first-child::before {
      display: none;
    }

    .register-stepper-dot {
      position: relative;
      z-index: 1;
      display: grid;
      width: 2.1rem;
      height: 2.1rem;
      place-items: center;
      border: 2px solid rgba(52, 211, 153, .28);
      border-radius: 999px;
      background: rgba(2, 22, 15, .9);
      color: rgba(167, 243, 208, .7);
      font-size: .85rem;
      font-weight: 800;
      transition: border-color .25s ease, background .25s ease, color .25s ease, box-shadow .25s ease;
    }

    .register-stepper-label {
      overflow: hidden;
      max-width: 100%;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .register-stepper-item.is-active {
      color: #d1fae5;
    }

    .register-stepper-item.is-active .register-stepper-dot {
      border-color: #34d399;
      background: #10b981;
      color: #022c1a;
      box-shadow: 0 0 0 5px rgba(16, 185, 129, .14), 0 0 18px rgba(16, 185, 129, .4);
    }

    .register-stepper-item.is-complete {
      color: #6ee7b7;
    }

    .register-stepper-item.is-complete .register-stepper-dot {
      border-color: #34d399;
      background: rgba(16, 185, 129, .16);
      color: #6ee7b7;
      font-size: 0;
    }

    .register-stepper-item.is-complete .register-stepper-dot::after {
      content: '✓';
      font-size: .85rem;
    }

    .register-stepper-item.is-complete::before {
      background: #10b981;
    }

    .register-step:not([hidden]) {
      animation: register-step-in .28s ease both;
    }

    @keyframes register-step-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .register-step:not([hidden]) {
        animation: none;
      }
    }

    .register-step-hint {
      margin: .65rem 0 0;
      color: rgba(167, 243, 208, .68);
      font-size: .8rem;
      line-height: 1.55;
    }

    @media (max-width: 640px) {
      .register-stepper {
        gap: .25rem;
        margin-bottom: 1.1rem;
      }

      .register-stepper-item {
        gap: .35rem;
        font-size: .58rem;
        letter-spacing: .06em;
      }

      .register-stepper-dot {
        width: 1.9rem;
        height: 1.9rem;
        font-size: .78rem;
      }

      .register-stepper-item::before {
        top: .95rem;
        right: calc(50% + 1.05rem);
        left: calc(-50% + 1.05rem);
      }
    }

    @media (max-width: 640px) {
      .register-card-content .register-footer.register-footer {
        display: flex;
        gap: .3rem;
        margin-top: .4rem;
        padding: .45rem .1rem 0;
        font-size: .65rem;
      }

      .register-card-content .register-footer-home a {
        min-height: 1.8rem;
        padding: .25rem .65rem;
        font-size: .65rem;
      }
    }
  </style>

  <header class="register-header fixed left-0 top-0 z-50 w-full border-b backdrop-blur-md">
    <div class="flex items-center justify-between gap-4">
      <div class="register-brand flex items-center gap-3">
        <img src="/images/minsu-logo.png.jpg" alt="Mindoro State University Logo" class="register-university-logo" />
        <div class="register-brand-copy flex flex-col leading-tight">
          <span class="register-brand-name text-lg font-bold text-white">Mindoro State University</span>
          <span class="register-brand-subtitle text-[10px] font-semibold uppercase tracking-[0.22em] text-emerald-400">College of Computer Studies</span>
        </div>
      </div>

      <nav class="register-nav" aria-label="Main navigation">
        <a href="/" class="text-base font-semibold text-slate-200 transition hover:text-emerald-400">Home</a>
        <a href="/#features" class="text-base font-semibold text-slate-200 transition hover:text-emerald-400">Features</a>
        <a href="/#about" class="text-base font-semibold text-slate-200 transition hover:text-emerald-400">About</a>
        <a href="/#contact" class="text-base font-semibold text-slate-200 transition hover:text-emerald-400">Contact</a>
      </nav>
    </div>
  </header>

  <div class="register-bg relative flex min-h-screen items-center">
    <main class="register-layout relative z-10">
      <section class="register-intro" aria-label="ComLab registration">
        <h1 class="register-headline">
          Computer Laboratory
          <span class="register-headline-highlight">Facilities Management System</span>
        </h1>
        <p>Access laboratory schedules, equipment services, and your personalized ComLab dashboard with one account.</p>
      </section>

      <div class="register-card-wrap">
      <div class="register-card custom-scrollbar overflow-y-auto rounded-2xl p-6">
        <div class="register-card-content h-full pr-2">
          <div class="register-logo mb-4 flex justify-center">
            <img src="/images/ccs-logo.png" alt="CCS Logo" class="h-14 w-14 object-contain drop-shadow-[0_0_20px_rgba(16,185,129,0.45)]" />
          </div>

          <div class="register-heading mb-4 text-center">
            <h1 class="text-xl font-extrabold text-white">Create Your Account</h1>
            <p class="mt-1.5 text-xs text-slate-300">Create your account to continue to ComLab and access your dashboard.</p>
            {{#if isEquipmentRegistration}}
              <p class="register-qr-notice mt-3 rounded-xl border border-emerald-400/20 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-100">You scanned an equipment QR code. Register as a Student, verify your email, and continue to the scanned item's borrow request.</p>
            {{/if}}
          </div>

          {{#if error_msg}}
            <div class="mb-6 rounded-2xl border border-red-400/25 bg-red-500/10 px-5 py-4 text-sm text-red-200 shadow-[0_10px_30px_rgba(0,0,0,0.18)] backdrop-blur-sm">{{error_msg}}</div>
          {{/if}}
          {{#if success_msg}}
            <div class="mb-6 rounded-2xl border border-emerald-400/25 bg-emerald-500/10 px-5 py-4 text-sm text-emerald-100 shadow-[0_10px_30px_rgba(0,0,0,0.18)] backdrop-blur-sm">{{success_msg}}</div>
          {{/if}}

          <form class="register-form-grid space-y-4 pb-6" autocomplete="off" method="POST" action="/register" novalidate>
            <div class="register-stepper" aria-label="Registration progress">
              <div class="register-stepper-item is-active" data-register-marker="1">
                <span class="register-stepper-dot">1</span>
                <span class="register-stepper-label">Account</span>
              </div>
              <div class="register-stepper-item" data-register-marker="2">
                <span class="register-stepper-dot">2</span>
                <span class="register-stepper-label">Campus</span>
              </div>
              <div class="register-stepper-item" data-register-marker="3">
                <span class="register-stepper-dot">3</span>
                <span class="register-stepper-label">Student</span>
              </div>
            </div>

            <div class="register-step" data-register-step="1">
              <div class="register-form-row grid gap-4 sm:grid-cols-2">
                <label class="block text-sm font-semibold text-slate-200">
                  Full Name
                  <input autocomplete="off" type="text" name="name" placeholder="Full Name" class="mt-2 w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white placeholder-emerald-200/50 transition-all focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300" required />
                </label>
                <input type="hidden" name="role" value="student">
              </div>

              <label class="register-full-field block text-sm font-semibold text-slate-200">
                Email address
                <input autocomplete="off" type="email" name="email" placeholder="Enter your email" class="mt-2 w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white placeholder-emerald-200/50 transition-all focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300" required />
              </label>

              <div class="register-form-row grid gap-4 sm:grid-cols-2">
                <label class="register-half-field block text-sm font-semibold text-slate-200">
                  Password
                  <div class="register-password-control">
                    <input id="registerPassword" autocomplete="new-password" type="password" name="password" placeholder="Create a password" class="w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white placeholder-emerald-200/50 transition-all focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300" required />
                    <button class="register-password-toggle" type="button" data-password-toggle="registerPassword" aria-label="Show password" aria-pressed="false">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                        <path class="register-password-eye-slash" d="m4 4 16 16" hidden></path>
                      </svg>
                    </button>
                  </div>
                </label>
                <label class="register-half-field block text-sm font-semibold text-slate-200">
                  Confirm Password
                  <div class="register-password-control">
                    <input id="registerConfirmPassword" autocomplete="new-password" type="password" name="confirmPassword" placeholder="Repeat password" class="w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white placeholder-emerald-200/50 transition-all focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300" required />
                    <button class="register-password-toggle" type="button" data-password-toggle="registerConfirmPassword" aria-label="Show password" aria-pressed="false">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                        <path class="register-password-eye-slash" d="m4 4 16 16" hidden></path>
                      </svg>
                    </button>
                  </div>
                </label>
              </div>

              <div class="register-step-controls">
                <button class="register-next" type="button" data-register-next>Continue</button>
              </div>
            </div>

            <div class="register-step" data-register-step="2" hidden>
              <div class="register-full-field">
                <label class="block text-sm font-semibold text-slate-200">
                  Campus
                  <select name="campus" required class="mt-2 w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300">
                    <option value="" selected disabled>Select Campus</option>
                    <option value="Bongabong">Bongabong</option>
                    <option value="Victoria">Victoria</option>
                    <option value="Calapan">Calapan</option>
                  </select>
                </label>
                <p class="register-step-hint">Choose the Mindoro State University campus where you are enrolled. This determines the laboratories, equipment, and schedules available to your account.</p>
              </div>

              <div class="register-step-controls">
                <button class="register-prev" type="button" data-register-prev>Back</button>
                <button class="register-next" type="button" data-register-next>Continue</button>
              </div>
            </div>

            <div class="register-step" data-register-step="3" hidden>
              <div id="studentRegistrationFields" class="register-student-fields space-y-4">
                <h2 class="text-sm font-bold uppercase tracking-wide text-emerald-200">Student information</h2>
                <div class="register-form-row grid gap-4 sm:grid-cols-2">
                  <label class="block text-sm font-semibold text-slate-200">
                    Student ID
                    <input id="studentIdInput" autocomplete="off" type="text" name="student_number" placeholder="e.g. 2023-0001" required class="mt-2 w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white placeholder-emerald-200/50 transition-all focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300" />
                  </label>
                  <label class="block text-sm font-semibold text-slate-200">
                    Program
                    <select name="program" required class="mt-2 w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300">
                      <option value="" selected disabled>Select Program</option>
                      <option value="BSIT">BSIT — Bachelor of Science in Information Technology</option>
                      <option value="BSCPE">BSCPE — Bachelor of Science in Computer Engineering</option>
                    </select>
                  </label>
                </div>

                <div class="register-form-row grid gap-4 sm:grid-cols-2">
                  <label class="block text-sm font-semibold text-slate-200">
                    Year
                    <select name="year" required class="mt-2 w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300">
                      <option value="" selected disabled>Select Year</option>
                      <option value="1st Year">1st Year</option>
                      <option value="2nd Year">2nd Year</option>
                      <option value="3rd Year">3rd Year</option>
                      <option value="4th Year">4th Year</option>
                    </select>
                  </label>
                  <label class="block text-sm font-semibold text-slate-200">
                    Section
                    <select name="section" required class="mt-2 w-full rounded-xl border border-emerald-400/40 bg-[#022814]/60 px-4 py-2.5 text-white focus:border-emerald-300 focus:bg-[#022814]/80 focus:outline-none focus:ring-1 focus:ring-emerald-300">
                      <option value="" selected disabled>Select Section</option>
                      <option value="F1">F1</option>
                      <option value="F2">F2</option>
                      <option value="F3">F3</option>
                    </select>
                  </label>
                </div>
              </div>

              {{#if isEquipmentRegistration}}
                <label class="register-full-field flex items-center gap-2 text-sm font-medium text-emerald-100/80">
                  <input type="checkbox" name="rememberMe" value="on" class="h-4 w-4 accent-emerald-400" />
                  <span>Remember me on this device for 30 days</span>
                </label>
              {{/if}}

              <div class="register-step-controls">
                <button class="register-prev" type="button" data-register-prev>Back</button>
                <button id="registerButton" class="register-create" type="submit" aria-label="Create account">Create Account</button>
              </div>
            </div>
          </form>

          <div id="registerLoading" class="hidden mt-5 rounded-2xl border border-emerald-300/20 bg-emerald-950/70 p-4 text-sm text-emerald-50 shadow-[0_10px_30px_rgba(0,0,0,0.18)] backdrop-blur-sm" role="status" aria-live="polite">
            <div class="flex items-center gap-3">
              <span class="h-5 w-5 shrink-0 animate-spin rounded-full border-2 border-emerald-100/25 border-t-emerald-300" aria-hidden="true"></span>
              <span><strong class="block">Sending verification code…</strong><span class="mt-0.5 block text-xs text-emerald-100/75">Setting up your account and sending a 6-digit code to your email.</span></span>
            </div>
          </div>

          <div class="register-footer">
            {{#if isEquipmentRegistration}}
              <p class="register-footer-account">Already have an account? <a href="/login">Log in</a> to continue with the scanned equipment.</p>
            {{else}}
              <p class="register-footer-account">Already have an account? <a href="/login">Log in</a></p>
            {{/if}}
            <p class="register-footer-home"><a href="/">&larr; Back to landing</a></p>
          </div>
        </div>
      </div>
    </div>
    </main>
  </div>
  <script>
    const form = document.querySelector('form[action="/register"]');
    const button = document.getElementById('registerButton');
    const loading = document.getElementById('registerLoading');
    const steps = Array.from(document.querySelectorAll('[data-register-step]'));
    const markers = Array.from(document.querySelectorAll('[data-register-marker]'));
    let currentStep = 1;
    document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const input = document.getElementById(toggle.dataset.passwordToggle);
        if (!input) return;

        const isVisible = input.type === 'text';
        input.type = isVisible ? 'password' : 'text';
        toggle.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password');
        toggle.setAttribute('aria-pressed', String(!isVisible));
        toggle.querySelector('.register-password-eye-slash').hidden = !isVisible;
      });
    });

    function findStep(stepNumber) {
      return steps.find((step) => Number(step.dataset.registerStep) === stepNumber);
    }

    function setStep(stepNumber) {
      currentStep = stepNumber;
      steps.forEach((step) => {
        const isActive = Number(step.dataset.registerStep) === stepNumber;
        step.hidden = !isActive;
        step.querySelectorAll('input, select, textarea').forEach((field) => {
          field.disabled = !isActive;
        });
      });

      markers.forEach((marker) => {
        const markerStep = Number(marker.dataset.registerMarker);
        marker.classList.toggle('is-active', markerStep === stepNumber);
        marker.classList.toggle('is-complete', markerStep < stepNumber);
        if (markerStep === stepNumber) {
          marker.setAttribute('aria-current', 'step');
        } else {
          marker.removeAttribute('aria-current');
        }
      });

      findStep(stepNumber)
        ?.querySelector('input:not([type="hidden"]):not([type="checkbox"]), select')
        ?.focus({ preventScroll: true });
    }

    function validateStep(stepNumber, shouldReport = true) {
      const step = findStep(stepNumber);
      if (!step) return true;

      const passwordInput = step.querySelector('input[name="password"]');
      const confirmPasswordInput = step.querySelector('input[name="confirmPassword"]');
      if (passwordInput && confirmPasswordInput) {
        confirmPasswordInput.setCustomValidity(
          passwordInput.value === confirmPasswordInput.value ? '' : 'Passwords do not match.'
        );
      }

      const invalid = step.querySelector('input:invalid, select:invalid, textarea:invalid');
      if (!invalid) return true;
      if (shouldReport) invalid.reportValidity();
      return false;
    }

    document.querySelectorAll('[data-register-next]').forEach((next) => {
      next.addEventListener('click', () => {
        if (!validateStep(currentStep)) return;
        if (currentStep < steps.length) setStep(currentStep + 1);
      });
    });

    document.querySelectorAll('[data-register-prev]').forEach((prev) => {
      prev.addEventListener('click', () => {
        if (currentStep > 1) setStep(currentStep - 1);
      });
    });

    if (form) {
      form.addEventListener('submit', (event) => {
        if (currentStep < steps.length) {
          event.preventDefault();
          if (validateStep(currentStep)) setStep(currentStep + 1);
          return;
        }

        steps.forEach((step) => {
          step.querySelectorAll('input, select, textarea').forEach((field) => {
            field.disabled = false;
          });
        });

        const invalidStep = steps.find((step) => !validateStep(Number(step.dataset.registerStep), false));
        if (invalidStep) {
          event.preventDefault();
          const stepNumber = Number(invalidStep.dataset.registerStep);
          setStep(stepNumber);
          findStep(stepNumber)?.querySelector(':invalid')?.reportValidity();
          return;
        }

        if (button) {
          button.disabled = true;
          button.setAttribute('aria-busy', 'true');
          button.textContent = 'Sending code…';
          button.classList.add('opacity-70', 'cursor-not-allowed');
        }
        if (loading) {
          loading.classList.remove('hidden');
        }
      });
    }

    setStep(1);

    {{#if error_msg}}
      if (loading) loading.classList.add('hidden');
      if (button) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = 'Create Account';
        button.classList.remove('opacity-70', 'cursor-not-allowed');
      }
    {{/if}}
  </script>
{{> footer }}

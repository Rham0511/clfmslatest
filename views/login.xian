{{> head}}
<style>
  :root {
    color-scheme: dark;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #f8fafc;
    background: #020806;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #f8fafc;
    background: #020806;
  }

  a {
    text-decoration: none;
  }

  .login-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    background: url('/images/MinSU_Bongabong_enhanced.jpg') center / cover no-repeat;
    filter: saturate(1.35) contrast(1.1) brightness(0.96);
    isolation: isolate;
  }

  .login-hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    background: linear-gradient(135deg, rgba(3, 16, 12, 0.58) 0%, rgba(2, 10, 22, 0.66) 100%);
  }

  .login-shell {
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    flex-direction: column;
  }

  .login-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: .75rem 2rem;
    border-bottom: 1px solid rgba(52, 211, 153, 0.18);
    background: rgba(3, 12, 9, 0.8);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(20px) saturate(1.3);
  }

  .login-brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: .75rem;
  }

  .login-brand img {
    width: 46px;
    height: 46px;
    min-width: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(52, 211, 153, 0.35);
    box-shadow: 0 0 14px rgba(16, 185, 129, 0.28);
  }

  .login-brand-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: .08rem;
  }

  .login-brand-name {
    color: #f8fafc;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .login-brand-subtitle {
    color: #34d399;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .login-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .login-nav a {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    padding: .5rem .75rem;
    border: 1px solid transparent;
    border-radius: .75rem;
    color: #e2e8f0;
    font-size: .88rem;
    font-weight: 650;
    transition: color .2s ease, background .2s ease, border-color .2s ease, transform .2s ease;
  }

  .login-nav a:hover,
  .login-nav a[aria-current="page"],
  .login-nav a:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(96, 165, 250, .2);
    outline: none;
    background: rgba(59, 130, 246, .12);
    color: #bfdbfe;
  }

  .login-menu-toggle {
    display: none;
    width: 2.65rem;
    height: 2.65rem;
    flex: 0 0 2.65rem;
    place-items: center;
    border: 1px solid rgba(148, 163, 184, .3);
    border-radius: .75rem;
    background: rgba(15, 23, 42, .55);
    color: #f8fafc;
    cursor: pointer;
  }

  .login-menu-toggle:hover,
  .login-menu-toggle:focus-visible {
    border-color: rgba(110, 231, 183, .6);
    outline: none;
    background: rgba(16, 185, 129, .16);
  }

  .login-menu-toggle svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .login-main {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1.5rem 2rem;
  }

  .login-grid {
    display: grid;
    width: min(1200px, 100%);
    grid-template-columns: minmax(0, 1fr) minmax(400px, 460px);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .login-intro {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .login-eyebrow {
    display: none;
  }

  .login-headline {
    margin: 0;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    color: #ffffff;
    font-size: clamp(2.6rem, 4.6vw, 4.2rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }

  .login-headline-highlight {
    display: block;
    background: linear-gradient(135deg, #4ade80 0%, #10b981 55%, #059669 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 4px 18px rgba(16, 185, 129, 0.35));
  }

  .login-intro p:last-child {
    max-width: 38rem;
    margin: 0;
    color: rgba(226, 232, 240, 0.92);
    font-size: 1.15rem;
    font-weight: 450;
    line-height: 1.65;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    justify-self: end;
    padding: clamp(1.1rem, 2vh, 1.5rem) clamp(1.2rem, 2vw, 1.75rem);
    border: 1px solid rgba(52, 211, 153, 0.35);
    border-radius: 1.5rem;
    background: linear-gradient(165deg,
      rgba(5, 32, 22, 0.85) 0%,
      rgba(3, 20, 15, 0.9) 50%,
      rgba(2, 11, 8, 0.95) 100%
    );
    box-shadow:
      0 0 35px rgba(16, 185, 129, 0.18),
      0 25px 60px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      inset 0 0 20px rgba(16, 185, 129, 0.05);
    backdrop-filter: blur(28px) saturate(1.35);
    -webkit-backdrop-filter: blur(28px) saturate(1.35);
  }

  .login-logo {
    display: block;
    width: 3rem;
    height: 3rem;
    margin: 0 auto 0.5rem;
    object-fit: contain;
    filter: drop-shadow(0 0 18px rgba(16, 185, 129, 0.5));
  }

  .login-card-heading {
    margin-bottom: 0.85rem;
    text-align: center;
  }

  .login-card-heading h2 {
    margin: 0;
    font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    color: #fff;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .login-card-heading p {
    margin: .25rem 0 0;
    color: #cbd5e1;
    font-size: .8rem;
    line-height: 1.4;
  }

  .login-message {
    margin-bottom: .75rem;
    padding: .65rem .85rem;
    border-radius: .75rem;
    font-size: .82rem;
  }

  .login-message.error {
    border: 1px solid rgba(248, 113, 113, .25);
    background: rgba(239, 68, 68, .1);
    color: #fecaca;
  }

  .login-message.success {
    border: 1px solid rgba(74, 222, 128, .25);
    background: rgba(16, 185, 129, .1);
    color: #d1fae5;
  }

  .login-form {
    display: grid;
    gap: .65rem;
  }

  .login-field label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .login-field input {
    width: 100%;
    min-height: 2.5rem;
    padding: .45rem .85rem;
    border: 1px solid rgba(52, 211, 153, 0.4);
    border-radius: .75rem;
    outline: none;
    background: rgba(2, 40, 20, 0.6);
    color: #fff;
    font: inherit;
    font-size: .88rem;
    transition: all .2s ease;
  }

  .login-field input::placeholder {
    color: rgba(167, 243, 208, .45);
  }

  .login-field input:focus {
    border-color: #34d399;
    background: rgba(2, 40, 20, 0.8);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.22);
  }

  .login-field input:-webkit-autofill,
  .login-field input:-webkit-autofill:hover,
  .login-field input:-webkit-autofill:focus {
    border: 1px solid rgba(52, 211, 153, 0.4);
    -webkit-text-fill-color: #ffffff;
    box-shadow: 0 0 0 1000px rgba(2, 40, 20, 0.6) inset;
    transition: background-color 9999s ease-out 0s;
  }

  .login-password-control {
    position: relative;
  }

  .login-password-control input {
    padding-right: 3.25rem;
  }

  .login-password-toggle {
    position: absolute;
    top: 50%;
    right: .65rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    padding: .35rem;
    transform: translateY(-50%);
    place-items: center;
    border: 0;
    border-radius: .5rem;
    background: transparent;
    color: #a7f3d0;
    cursor: pointer;
  }

  .login-password-toggle:hover,
  .login-password-toggle:focus-visible {
    background: rgba(34, 197, 94, .14);
    outline: none;
  }

  .login-password-toggle svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .login-remember {
    display: flex;
    align-items: center;
    gap: .55rem;
    color: #d1fae5;
    font-size: .8rem;
    margin-top: .1rem;
  }

  .login-remember input {
    width: .95rem;
    min-height: .95rem;
    margin: 0;
    accent-color: #22c55e;
  }

  .login-submit {
    min-height: 2.75rem;
    margin-top: .2rem;
    border: 1px solid transparent;
    border-radius: .8rem;
    background: #10b981;
    color: #020617;
    font-size: .92rem;
    font-weight: 750;
    font-family: 'Plus Jakarta Sans', sans-serif;
    cursor: pointer;
    transition: all .2s ease;
  }

  .login-submit:hover {
    transform: translateY(-2px);
    background: #34d399;
  }

  .login-links {
    display: grid;
    gap: .65rem;
    margin-top: 1rem;
    padding-top: .85rem;
    border-top: 1px solid rgba(167, 243, 208, .12);
    color: #cbd5e1;
    font-size: .78rem;
    text-align: center;
  }

  .login-links p {
    margin: 0;
    line-height: 1.5;
  }

  .login-links .login-link-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
  }

  .login-links .login-forgot-link {
    text-align: right;
  }

  .login-links a {
    color: #6ee7b7;
    font-weight: 700;
    transition: color .2s ease;
  }

  .login-links a:hover {
    color: #a7f3d0;
  }

  .login-links .login-home-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    color: #6ee7b7;
    font-size: .78rem;
    font-weight: 700;
    transition: color .2s ease;
  }

  .login-links > p:last-child {
    text-align: center;
  }

  .login-links .login-home-link:hover,
  .login-links .login-home-link:focus-visible {
    color: #a7f3d0;
    outline: none;
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  @media (max-width: 900px) {
    .login-header {
      display: flex;
      flex-wrap: nowrap;
      justify-content: space-between;
    }

    .login-brand {
      flex: 1 1 auto;
    }

    .login-menu-toggle {
      display: grid;
    }

    .login-nav {
      position: absolute;
      top: calc(100% + .4rem);
      right: .85rem;
      display: grid;
      width: min(18rem, calc(100vw - 1.7rem));
      gap: .25rem;
      padding: .5rem;
      border: 1px solid rgba(148, 163, 184, .2);
      border-radius: .9rem;
      background: rgba(7, 17, 31, .96);
      box-shadow: 0 16px 38px rgba(2, 6, 23, .42);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-.4rem);
      transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
      visibility: hidden;
    }

    .login-header.is-menu-open .login-nav {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      visibility: visible;
    }

    .login-nav a {
      justify-content: flex-start;
      min-height: 2.7rem;
      padding: .65rem .8rem;
    }

    .login-menu-toggle:focus-visible,
    .login-nav a:focus-visible {
      outline: 2px solid #6ee7b7;
      outline-offset: 2px;
    }

    .login-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 2rem;
      text-align: center;
    }

    .login-intro {
      align-items: center;
    }

    .login-intro h1 {
      max-width: 700px;
    }

    .login-card {
      justify-self: center;
    }
  }

  @media (max-width: 760px) {
    .login-main {
      align-items: flex-start;
      padding-top: 2rem;
    }

    .login-grid {
      width: min(100%, 520px);
      gap: 1.5rem;
    }

    .login-intro {
      gap: .6rem;
    }

    .login-intro h1 {
      font-size: clamp(1.8rem, 7vw, 2.7rem);
      line-height: 1.08;
    }

    .login-intro p:last-child {
      max-width: 38rem;
    }
  }

  @media (max-width: 640px) {
    .login-header {
      justify-content: space-between;
      gap: .65rem;
      padding: .7rem .85rem;
    }

    .login-brand {
      order: 1;
      width: auto;
      gap: .55rem;
    }

    .login-menu-toggle {
      order: 2;
    }

    .login-brand img {
      width: 42px;
      height: 42px;
      min-width: 42px;
    }

    .login-brand-name {
      font-size: .88rem;
    }

    .login-brand-subtitle {
      font-size: .55rem;
      letter-spacing: .1em;
    }

    .login-nav {
      right: .85rem;
    }

    .login-main {
      padding: 1.4rem .9rem 2rem;
    }

    .login-grid {
      gap: 1.2rem;
    }

    .login-intro {
      gap: .45rem;
    }

    .login-links .login-link-row {
      align-items: stretch;
      flex-direction: column;
      gap: .25rem;
    }

    .login-links .login-forgot-link {
      text-align: left;
    }

    .login-eyebrow {
      font-size: .8rem;
      letter-spacing: .18em;
    }

    .login-intro h1 {
      font-size: clamp(1.7rem, 8vw, 2.4rem);
    }

    .login-intro p:last-child {
      font-size: .88rem;
      line-height: 1.5;
    }

    .login-card {
      max-width: 100%;
      padding: 1.35rem;
      border-radius: 1.2rem;
    }

    .login-logo {
      width: 3.5rem;
      height: 3.5rem;
      margin-bottom: .85rem;
    }

    .login-card-heading {
      margin-bottom: 1.25rem;
    }

    .login-card-heading h2 {
      font-size: 1.4rem;
    }

    .login-card-heading p {
      font-size: .84rem;
    }

    .login-form {
      gap: .9rem;
    }

    .login-links {
      gap: .65rem;
      margin-top: 1.1rem;
    }
  }

  @media (max-width: 380px) {
    .login-brand img {
      width: 38px;
      height: 38px;
      min-width: 38px;
    }

    .login-brand-name {
      font-size: .78rem;
    }

    .login-brand-subtitle {
      font-size: .48rem;
      letter-spacing: .08em;
    }

    .login-card {
      padding: 1.1rem;
    }
  }

  @media (min-width: 901px) {
    .login-main {
      min-height: 0;
      padding: clamp(0.5rem, 1.8vh, 1.5rem) 2rem;
    }

    .login-grid {
      display: grid;
      width: min(1200px, 100%);
      grid-template-columns: minmax(0, 1.15fr) minmax(390px, 450px);
      align-items: center;
      gap: clamp(2rem, 5vw, 5rem);
    }
  }

  .login-hero {
    background: #111614;
    filter: none;
  }

  .login-hero::before {
    background: #111614;
  }

  .login-header {
    border-bottom-color: #303833;
    background: #111614;
    box-shadow: none;
    backdrop-filter: none;
  }

  .login-main {
    padding: 2rem 1rem 2.5rem;
  }

  .login-grid {
    display: grid;
    width: min(520px, 100%);
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  .login-intro {
    gap: .45rem;
  }

  .login-headline {
    font-size: clamp(1.7rem, 4vw, 2rem);
    text-shadow: none;
  }

  .login-headline-highlight {
    background: none;
    color: #58BE67;
    filter: none;
    -webkit-text-fill-color: currentColor;
  }

  .login-intro p:last-child {
    color: #A5AEA8;
    font-size: .9rem;
    line-height: 1.5;
    text-shadow: none;
  }

  .login-card {
    max-width: none;
    justify-self: stretch;
    padding: clamp(1.25rem, 4vw, 1.75rem);
    border: 1px solid #343C37;
    border-radius: 1.25rem;
    background: #1C2420;
    box-shadow: 0 16px 36px rgba(0, 0, 0, .22);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .login-logo {
    display: none;
  }

  .login-card-heading {
    margin-bottom: 1.1rem;
    text-align: left;
  }

  .login-card-heading h2 {
    font-size: 1.6rem;
  }

  .login-card-heading p {
    color: #A5AEA8;
    font-size: .9rem;
  }

  .login-form {
    gap: .85rem;
  }

  .login-field label,
  .login-remember {
    color: #C5CDC8;
  }

  .login-field input {
    min-height: 3rem;
    padding: .65rem .9rem;
    border-color: #414A44;
    border-radius: .7rem;
    background: #151A17;
    color: #F3F6F4;
  }

  .login-field input::placeholder {
    color: #87918A;
  }

  .login-field input:focus {
    border-color: #58BE67;
    background: #151A17;
    box-shadow: 0 0 0 3px rgba(88, 190, 103, .16);
  }

  .login-field input:-webkit-autofill,
  .login-field input:-webkit-autofill:hover,
  .login-field input:-webkit-autofill:focus {
    border-color: #414A44;
    -webkit-text-fill-color: #F3F6F4;
    box-shadow: 0 0 0 1000px #151A17 inset;
  }

  .login-password-toggle {
    color: #A5AEA8;
  }

  .login-password-toggle:hover,
  .login-password-toggle:focus-visible {
    background: #27322B;
  }

  .login-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
  }

  .login-forgot-inline {
    color: #58BE67;
    font-size: .82rem;
    font-weight: 700;
    text-decoration: none;
  }

  .login-forgot-inline:hover,
  .login-forgot-inline:focus-visible {
    color: #79D184;
    text-decoration: underline;
    text-underline-offset: .15em;
  }

  .login-submit {
    min-height: 3.1rem;
    border-radius: .7rem;
    background: #58BE67;
    color: #102014;
  }

  .login-submit:hover {
    transform: none;
    background: #69CC76;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: .8rem;
    margin: .15rem 0;
    color: #A5AEA8;
    font-size: .82rem;
  }

  .auth-divider::before,
  .auth-divider::after {
    height: 1px;
    flex: 1;
    background: #3A433D;
    content: "";
  }

  .google-auth-button {
    display: flex;
    width: 100%;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    border: 1px solid #D8DEDA;
    border-radius: .45rem;
    background: #FFFFFF;
    color: #202124;
    font-size: .92rem;
    font-weight: 600;
    text-decoration: none;
    line-height: 1;
    transition: background-color .15s ease, box-shadow .15s ease;
  }

  .google-auth-button:hover,
  .google-auth-button:focus-visible {
    background: #F8FAF9;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .18);
    outline: none;
  }

  .google-auth-button[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: .58;
  }

  .google-auth-button:disabled {
    border-color: #3A433D;
    background: #17211B;
    color: #A5AEA8;
    opacity: 1;
    box-shadow: none;
  }

  .google-auth-button:disabled .google-auth-mark {
    filter: grayscale(1);
    opacity: .65;
  }

  .google-auth-mark {
    width: 1.25rem;
    height: 1.25rem;
    display: block;
    flex: 0 0 1.25rem;
    object-fit: contain;
  }

  .google-auth-note {
    margin: .35rem 0 0;
    color: #A5AEA8;
    font-size: .72rem;
    line-height: 1.4;
    text-align: center;
  }

  .login-links {
    margin-top: .75rem;
    padding-top: .75rem;
    border-top-color: #343C37;
    color: #A5AEA8;
  }

  .login-links .login-link-row {
    justify-content: center;
  }

  .login-links a,
  .login-links .login-home-link {
    color: #58BE67;
  }

  .login-links .login-home-link {
    color: #A5AEA8;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .login-main {
      align-items: center;
      padding: 1.5rem .85rem 2rem;
    }

    .login-grid {
      width: min(100%, 520px);
      gap: 1rem;
    }

    .login-card {
      padding: 1.25rem;
    }

    .login-card-heading {
      margin-bottom: 1rem;
    }

    .login-form {
      gap: .8rem;
    }
  }

  @media (min-width: 901px) {
    .login-hero {
      background: url('/images/MinSU_Bongabong_enhanced.jpg') center / cover no-repeat;
    }

    .login-hero::before {
      background: linear-gradient(135deg, rgba(3, 16, 12, .58) 0%, rgba(2, 10, 22, .72) 100%);
    }

    .login-main {
      padding: 2rem;
    }

    .login-grid {
      width: min(1200px, 100%);
      grid-template-columns: minmax(0, 1fr) minmax(390px, 450px);
      gap: clamp(2rem, 5vw, 5rem);
    }

    .login-intro {
      align-items: flex-start;
      gap: 1.25rem;
      text-align: left;
    }

    .login-headline {
      font-size: clamp(2.4rem, 4.2vw, 3.8rem);
      text-shadow: 0 4px 24px rgba(0, 0, 0, .5);
    }

    .login-headline-highlight {
      background: linear-gradient(135deg, #4ade80 0%, #10b981 55%, #059669 100%);
      background-clip: text;
      filter: drop-shadow(0 4px 18px rgba(16, 185, 129, .35));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .login-intro p:last-child {
      max-width: 38rem;
      color: rgba(226, 232, 240, .92);
      font-size: 1.05rem;
      line-height: 1.6;
      text-shadow: 0 2px 14px rgba(0, 0, 0, .5);
    }

    .login-card {
      max-width: 450px;
      justify-self: end;
    }
  }
</style>
<body>
  <section class="login-hero">
    <div class="login-shell">
      <header class="login-header">
        <a class="login-brand" href="/" aria-label="Mindoro State University home">
          <img src="/images/minsu-logo.png.jpg" alt="Mindoro State University Logo" />
          <span class="login-brand-copy">
            <span class="login-brand-name">Mindoro State University</span>
            <span class="login-brand-subtitle">College of Computer Studies</span>
          </span>
        </a>

        <nav id="login-nav" class="login-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/#features">Features</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>

        <button class="login-menu-toggle" type="button" aria-label="Open navigation menu" aria-controls="login-nav" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

      </header>

      <main class="login-main">
        <div class="login-grid">
          <section class="login-intro">
            <h1 class="login-headline">
              Computer Laboratory
              <span class="login-headline-highlight">Facilities Management System</span>
            </h1>
            <p>Manage laboratory logs, equipment reports, inventory, and borrow requests in one centralized platform.</p>
          </section>

          <section class="login-card" aria-labelledby="loginTitle">
            <img src="/images/ccs-logo.png" alt="CCS Logo" class="login-logo" />
            <div class="login-card-heading">
              <h2 id="loginTitle">Sign In to ComLab</h2>
              <p>Login to continue to ComLab and access your dashboard.</p>
              {{#if isEquipmentLogin}}
                <p class="login-message success" role="status">You scanned an equipment QR. Sign in to continue directly to that item’s borrow request.</p>
              {{/if}}
            </div>

            {{#if error_msg}}
              <div class="login-message error" role="alert">{{error_msg}}</div>
            {{/if}}
            {{#if success_msg}}
              <div class="login-message success" role="status">{{success_msg}}</div>
            {{/if}}
            {{#if pcStationNotice}}
              <div class="login-message error" role="alert">{{pcStationNotice}}</div>
              <button class="login-submit" id="scanPcStationButton" type="button">Scan PC station</button>
            {{/if}}

            <form class="login-form" autocomplete="off" method="POST" action="/login">
              <input type="hidden" name="pending_station" value="{{pendingPcStationToken}}" />
              <div class="login-field">
                <label for="email">Email Address</label>
                <input id="email" autocomplete="off" type="email" name="email" placeholder="you@example.com" required />
              </div>

              <div class="login-field">
                <label for="password">Password</label>
                <div class="login-password-control">
                  <input id="password" autocomplete="off" type="password" name="password" placeholder="Enter your password" required />
                  <button class="login-password-toggle" type="button" aria-label="Show password" aria-pressed="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                      <path class="login-password-eye-slash" d="m4 4 16 16" hidden></path>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="login-options">
                <label class="login-remember">
                  <input type="checkbox" name="rememberMe" value="on" />
                  <span>Remember me</span>
                </label>
                <a class="login-forgot-inline" href="/forgot-password">Forgot password?</a>
              </div>
              <button class="login-submit" type="submit">Sign in</button>
            </form>

            <div class="auth-divider" aria-hidden="true"><span>or</span></div>
            {{#if googleAuthAvailable}}
              <a class="google-auth-button" href="/auth/google?intent=login">
                <img class="google-auth-mark" src="/images/google-g.svg" alt="" aria-hidden="true" />
                <span>Continue with Google</span>
              </a>
            {{else}}
              <button class="google-auth-button" type="button" aria-disabled="true" disabled>
                <img class="google-auth-mark" src="/images/google-g.svg" alt="" aria-hidden="true" />
                <span>Google sign-in unavailable</span>
              </button>
              <p class="google-auth-note">Google sign-in needs server OAuth configuration. Manual email sign-in is still available.</p>
            {{/if}}

            <div class="login-links">
              <div class="login-link-row">
                {{#if isEquipmentLogin}}
                  <p>Don't have an account? <a href="/register?role=faculty">Register</a></p>
                {{else}}
                  <p>Don't have an account? <a href="/register">Sign up</a></p>
                {{/if}}
              </div>
              <p><a class="login-home-link" href="/">&larr; Back to ComLab</a></p>
            </div>
          </section>
        </div>
      </main>
    </div>
  </section>
<script src="/js/qr-scanner-button.js?v=12" defer></script>
<script>
  const scanPcStationButton = document.getElementById('scanPcStationButton');
  scanPcStationButton?.addEventListener('click', () => {
    if (typeof window.openComLabQRScanner !== 'function') {
      console.error('The PC station QR scanner is not available.');
      return;
    }
    window.openComLabQRScanner({ flow: 'pc-station' });
  });

  const loginHeader = document.querySelector('.login-header');
  (() => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('notice') === 'pc-station-occupied') {
      const pendingKeys = ['pending_pc_station', 'pending_station', 'pendingStation'];
      pendingKeys.forEach((key) => {
        localStorage.removeItem(key);
        sessionStorage.removeItem(key);
      });
    }
    const station = params.get('station') || params.get('pcStation') || params.get('pcStationToken') ||
      params.get('pc_id') || params.get('pcId') || params.get('pc') || params.get('code') ||
      params.get('pending_station') || params.get('pendingStation');
    if (station) {
      localStorage.setItem('pending_pc_station', station);
    } else {
      const formValue = document.querySelector('input[name="pending_station"]')?.value;
      if (formValue) localStorage.setItem('pending_pc_station', formValue);
    }
  })();

  const loginMenuToggle = document.querySelector('.login-menu-toggle');
  const loginNav = document.getElementById('login-nav');
  const closeLoginMenu = () => {
    loginHeader?.classList.remove('is-menu-open');
    loginMenuToggle?.setAttribute('aria-expanded', 'false');
    loginMenuToggle?.setAttribute('aria-label', 'Open navigation menu');
  };

  loginMenuToggle?.addEventListener('click', () => {
    const isOpen = loginMenuToggle.getAttribute('aria-expanded') === 'true';
    loginHeader?.classList.toggle('is-menu-open', !isOpen);
    loginMenuToggle.setAttribute('aria-expanded', String(!isOpen));
    loginMenuToggle.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
  });

  loginNav?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) closeLoginMenu();
  });

  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !loginHeader?.contains(event.target)) closeLoginMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && loginMenuToggle?.getAttribute('aria-expanded') === 'true') {
      closeLoginMenu();
      loginMenuToggle.focus();
    }
  });

  const passwordInput = document.getElementById('password');
  const passwordToggle = document.querySelector('.login-password-toggle');

  passwordToggle?.addEventListener('click', () => {
    const isVisible = passwordInput.type === 'text';
    passwordInput.type = isVisible ? 'password' : 'text';
    passwordToggle.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password');
    passwordToggle.setAttribute('aria-pressed', String(!isVisible));
    passwordToggle.querySelector('.login-password-eye-slash').hidden = !isVisible;
  });
</script>
{{> footer }}
